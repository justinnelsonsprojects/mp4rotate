<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window when Explorer runs it. See Program.cs for console handling. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mp4rotate</AssemblyName>
    <RootNamespace>Mp4Rotate</RootNamespace>

    <!-- Version info shown in the exe's Properties > Details tab -->
    <Version>1.1.0</Version>
    <Company>JRN Enterprise Inc</Company>
    <Product>MP4/MOV Rotate</Product>
    <Copyright>Copyright (c) JRN Enterprise Inc</Copyright>
    <Description>Lossless MP4/MOV rotation</Description>
    <!-- Generated by tools\make-appicon.ps1; also Setup's icon. Apps & Features shows it via UninstallDisplayIcon. -->
    <ApplicationIcon>installer\mp4rotate.ico</ApplicationIcon>

    <!-- 'dotnet publish' produces a single native exe with no .NET runtime dependency -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
